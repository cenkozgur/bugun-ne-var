{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Event title"
    },
    "competition_id": {
      "type": "string",
      "description": "Reference to Competition"
    },
    "category_id": {
      "type": "string",
      "description": "Reference to Category"
    },
    "start_time": {
      "type": "string",
      "format": "date-time",
      "description": "Event start time"
    },
    "broadcaster": {
      "type": "string",
      "description": "TV broadcaster"
    },
    "venue": {
      "type": "string",
      "description": "Event venue"
    },
    "is_live": {
      "type": "boolean",
      "default": false,
      "description": "Whether event is currently live"
    },
    "live_status": {
      "type": "string",
      "description": "Current live status text"
    },
    "home_score": {
      "type": "number",
      "description": "Live score of the home team (only meaningful while is_live or after the match)"
    },
    "away_score": {
      "type": "number",
      "description": "Live score of the away team"
    },
    "competition_name": {
      "type": "string",
      "description": "Denormalized competition name for display"
    },
    "external_ref": {
      "type": "string",
      "description": "Stable identifier from the upstream data source (e.g. football:20079, f1:2026:4:Race). Used by /seed to dedupe re-runs."
    },
    "competition_ref": {
      "type": "string",
      "description": "external_ref of the parent competition (e.g. league:T1). Lets us filter events by competition subscription without requiring the competition_id wiring."
    },
    "home_entity_ref": {
      "type": "string",
      "description": "external_ref of the home team/entity (e.g. team:T1:fenerbahce). Matches TrackedEntity.external_ref. Lets us filter events by team subscription."
    },
    "away_entity_ref": {
      "type": "string",
      "description": "external_ref of the away team/entity."
    }
  },
  "required": [
    "title",
    "category_id",
    "start_time"
  ]
}