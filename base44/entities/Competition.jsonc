{
  "name": "Competition",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Competition name"
    },
    "category_id": {
      "type": "string",
      "description": "Reference to Category"
    },
    "season": {
      "type": "string",
      "description": "Season identifier"
    },
    "external_ref": {
      "type": "string",
      "description": "Stable upstream id used for /seed dedup (e.g. league:T1, league:E0)."
    }
  },
  "required": [
    "name",
    "category_id"
  ]
}