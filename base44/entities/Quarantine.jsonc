{
  "name": "Quarantine",
  "type": "object",
  "properties": {
    "external_ref": {
      "type": "string",
      "description": "Event.external_ref to suppress (e.g. football:21819). Sync.mjs reads this entity and merges with EXT_REF_DENYLIST at runtime."
    },
    "reason": {
      "type": "string",
      "description": "Why the user reported this match as phantom (free text, optional)."
    }
  },
  "required": [
    "external_ref"
  ]
}
