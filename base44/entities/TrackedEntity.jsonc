{
  "name": "TrackedEntity",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Entity name (team, player, program)"
    },
    "category_id": {
      "type": "string",
      "description": "Reference to Category"
    },
    "type": {
      "type": "string",
      "enum": [
        "team",
        "player",
        "program"
      ],
      "description": "Type of tracked entity"
    },
    "external_ref": {
      "type": "string",
      "description": "Stable upstream id used for /seed dedup (e.g. team:T1:Fenerbahce)"
    }
  },
  "required": [
    "name",
    "category_id",
    "type"
  ]
}